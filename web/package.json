{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-sw.mjs",
    "build": "next build",
    "start": "next start",
    "sync": "node scripts/sync-content.mjs",
    "import:my": "node scripts/import-chat-translation.mjs && node scripts/sync-content.mjs",
    "pdf": "node scripts/print-pdf.mjs",
    "deploy": "npx -y wrangler@4 pages deploy out --project-name modern-swe --branch main --commit-dirty=true",
    "release": "npm run sync && npm run build && npm run deploy",
    "deploy:vercel": "npx -y vercel@59.11.2 --prod --yes",
    "serve": "npx -y serve@14 out -l 3210"
  },
  "dependencies": {
    "markdown-it": "^15.0.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
